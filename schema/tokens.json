{
  "schema_version": 1,
  "note": "Non-colour design tokens for the Cybercore Systems Framework. Colours are in cybergrid.json. Mirrors css/cybertokens.css for non-CSS consumers.",
  "font": {
    "mono": "\"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
    "ui": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "display": "mono"
  },
  "type_scale": {
    "ratio": 1.20,
    "base_px": 16,
    "rem": { "fs-0": 0.694, "fs-1": 0.833, "fs-2": 1.0, "fs-3": 1.2, "fs-4": 1.44, "fs-5": 1.728, "fs-6": 2.074, "fs-7": 2.488 }
  },
  "line_height": { "tight": 1.15, "snug": 1.35, "normal": 1.6, "loose": 1.85 },
  "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
  "tracking_em": { "tight": -0.01, "normal": 0.0, "wide": 0.04, "caps": 0.08 },
  "space_rem": { "0": 0, "1": 0.25, "2": 0.5, "3": 0.75, "4": 1.0, "5": 1.5, "6": 2.0, "7": 3.0, "8": 4.0 },
  "radius_px": { "sharp": 2, "sm": 4, "md": 8, "lg": 14, "pill": 999, "default": "sharp" },
  "border_px": { "hair": 1, "accent": 3 },
  "motion": {
    "ease_out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease_in_out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "dur_s": { "fast": 0.12, "mid": 0.24, "slow": 0.5 }
  },
  "z_index": { "base": 1, "sticky": 10, "popover": 60, "modal": 100, "toast": 200 }
}
